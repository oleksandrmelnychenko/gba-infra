[Unit]
Description=GBA QA NBA API (isolated sources, generation disabled)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/projects/gba-nba
EnvironmentFile=/private/gba-qa/nba/qa.env
ExecStart=/root/projects/gba-nba/.venv/bin/python -m uvicorn app.api.main:app --host 0.0.0.0 --port 8003
Restart=on-failure
RestartSec=3
SyslogIdentifier=gba-nba-qa
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/private/gba-qa/nba
PrivateTmp=true

[Install]
WantedBy=multi-user.target
