# Copy to .env.dev and .env.prod, fill in real values. Never commit those.
#
# SQL Server SA password for the gba-mssql container of this environment.
# Must match the password embedded in the connection-string secret files
# under secrets/<env>/.
SQL_SA_PASSWORD=change-me-strong-password

# Public domain for the PROD Caddy reverse proxy (prod only).
PROD_DOMAIN=example.com
