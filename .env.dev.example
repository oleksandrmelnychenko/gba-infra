# Copy to .env.dev and replace every CHANGE_ME value. Never commit .env.dev.
SQL_SA_PASSWORD=CHANGE_ME_SQL_SA_PASSWORD

# Normal local runtime. Maintenance/QA must stay disabled unless a reviewed
# maintenance runbook explicitly enables them.
DATA_CONCORD_MAINTENANCE_ENABLED=false
DATA_CONCORD_MAINTENANCE_CUTOVER_ID=
DATA_CONCORD_QA_ENABLED=false
DATA_CONCORD_QA_ALLOWED_USER_NET_IDS=
DATA_CONCORD_SCHEDULER_TASKS_ENABLED=true
DATA_CONCORD_BACKGROUND_WRITERS_ENABLED=true

# Must match Security__PriceEncryptionKey and Security__PriceEncryptionIV in
# secrets/dev. They are build/runtime inputs for the storefront.
PRICE_ENCRYPTION_KEY=CHANGE_ME_PRICE_ENCRYPTION_KEY
PRICE_ENCRYPTION_IV=CHANGE_ME_PRICE_ENCRYPTION_IV
